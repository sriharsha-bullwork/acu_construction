<?xml version="1.0"?>
<!--
  NavigateThroughPoses, no periodic replanning.
  - Clear both costmaps ONCE at start (before planning).
  - Compute a single global path once (SingleTrigger).
  - FollowPath keeps using that path forever.
  - Collision Monitor handles stopping; no replan on obstruction.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <Sequence name="Navigate_NoReplan">

      <!-- Execute this inner sequence only once -->
      <SingleTrigger name="PlanOnce">
        <Sequence name="PlanSequence">

          <!-- Clear costmaps ONCE so no stale obstacles remain -->
          <ClearEntireCostmap name="ClearLocalCostmap-Startup"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
                              
          <ClearEntireCostmap name="ClearGlobalCostmap-Startup"
                              service_name="global_costmap/clear_entirely_global_costmap"/>
                              

          <!-- If you pass multiple waypoints, drop ones you’ve already reached -->
          <RemovePassedGoals input_goals="{goals}"
                             output_goals="{goals}"
                             radius="1.5"/>

          <!-- One-shot global plan through poses -->
          <ComputePathThroughPoses goals="{goals}"
                                   path="{path}"
                                   planner_id="GridBased"/>
        </Sequence>
      </SingleTrigger>

      <!-- Track the fixed path (CM will gate cmd_vel to zero if blocked) -->
      <FollowPath path="{path}" controller_id="FollowPath"/>

    </Sequence>

  </BehaviorTree>
</root>