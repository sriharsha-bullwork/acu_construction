\<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="NavigateRecovery" number_of_retries="36">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">

          <!-- ComputePathToPose with delayed recovery -->
          <RecoveryNode name="ComputePathToPose" number_of_retries="36">
            <!-- 1) Primary action -->
            <ComputePathToPose
              goal="{goal}"
              path="{path}"
              planner_id="GridBased"/>
            <!-- 2) Single recovery subtree -->
            <Sequence name="ComputeRecoveryWithDelay">
              <!-- Wait 10 s before rerouting -->
              <Wait wait_duration="10"/>
              <ReactiveFallback name="ComputeRecoveryFallback">
                <GoalUpdated/>
                <ClearEntireCostmap
                  name="ClearGlobalCostmap-Context"
                  service_name="global_costmap/clear_entirely_global_costmap"/>
              </ReactiveFallback>
            </Sequence>
          </RecoveryNode>

        </RateController>

        <!-- FollowPath with delayed recovery -->
        <RecoveryNode name="FollowPath" number_of_retries="36">
          <!-- 1) Primary action -->
          <FollowPath
            path="{path}"
            controller_id="FollowPath"/>
          <!-- 2) Single recovery subtree -->
          <Sequence name="FollowRecoveryWithDelay">
            <Wait wait_duration="10"/>
            <ReactiveFallback name="FollowRecoveryFallback">
              <GoalUpdated/>
              <ClearEntireCostmap
                name="ClearLocalCostmap-Context"
                service_name="local_costmap/clear_entirely_local_costmap"/>
            </ReactiveFallback>
          </Sequence>
        </RecoveryNode>

      </PipelineSequence>

      <!-- Global system-level recovery (unchanged) -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap
              name="ClearLocalCostmap-Subtree"
              service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
          <Wait wait_duration="10"/>
        </RoundRobin>
      </ReactiveFallback>

    </RecoveryNode>
  </BehaviorTree>
</root>